  },
  "gaze": {
   "range": [
    -1,
    1
   ],
   "note": "added to expression gaze"
  },
  "blink": {
   "auto": "every 3.4 s, 0.18 s; false disables"
  },
  "scroll": {
   "range": [
    0,
    1
   ],
   "note": "0 = stuck to newest message (bottom), 1 = oldest"
  }
 },
 "slots": {
  "chat_lines": {
   "type": "array",
   "item": {
    "from": "user|ai",
    "text": "short Russian text, wraps to 5 lines at 300 px, ellipsis after",
    "expr": "expression for the avatar of an ai line",
    "emoji": "inline emoji name at bubble end",
    "react": "[{e: emoji name, n: count}] chips under the bubble"
   }
  },
  "typing": {
   "type": "bool",
   "note": "AI typing indicator bubble at the end of the list"
  },
  "phrase": {
   "type": "string",
   "note": "one line, ellipsised to the screen / cloud width"
  },
  "emoji": {
   "type": "string",
